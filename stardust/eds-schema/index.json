    {
     "role": "heading",
     "order": 0,
     "text": "Welcome to VA.gov"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Let us help you get started"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Whether you’re a Veteran, service member, or family member, we’re here to help you get the care and benefits you deserve."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Get started with VA",
     "href": "/resources/getting-started-with-va/"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Create an account to manage your VA benefits and care in one place — any time, from anywhere."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Create account",
     "href": "https://www.va.gov/sign-in"
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Learn how an account helps you",
     "href": "/resources/creating-an-account-for-vagov/"
    }
