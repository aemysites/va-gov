  {
   "section": "news-promo",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "VA NEWS"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Download the VA Health and Benefits App"
    },
    {
     "role": "body",
     "order": 2,
     "text": "With the VA Health and Benefits App, you can refill prescriptions, message your care team or check your VA benefits using your smartphone."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Read the full article",
     "href": "https://news.va.gov/138519/download-the-va-health-and-benefits-app/"
    },
    {
     "role": "cta",
     "order": 4,
     "text": "More VA news",
     "href": "https://news.va.gov/"
    }
   ],
   "imgCount": 1,
   "editableTexts": 4,
   "repeats": []
  },
  {
   "section": "hub-grid",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Explore VA benefits and health care"
    },
    {
     "role": "cta",
     "order": 1,
     "text": "Health care",
     "href": "/health-care"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Apply for VA health care, find out how to access services, and manage your health and benefits online."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Disability",
     "href": "/disability"
    },
    {
     "role": "body",
     "order": 4,
     "text": "File a claim for disability compensation for conditions related to your military service, and manage your benefits over time."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Education and training",
     "href": "/education"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Apply for and manage your GI Bill and other education benefits to help pay for college and training programs."
    },
    {
     "role": "cta",
     "order": 7,
     "text": "Careers and employment",
     "href": "/careers-employment"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Apply for vocational rehabilitation services, get support for your Veteran-owned small business, and access other career resources."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Pension",
     "href": "/pension"
    },
    {
     "role": "body",
     "order": 10,
     "text": "Apply for monthly payments for wartime Veterans and survivors with limited or no income who meet certain age and disability requirements."
    },
    {
     "role": "cta",
     "order": 11,
     "text": "Housing assistance",
     "href": "/housing-assistance"
    },
    {
     "role": "body",
     "order": 12,
     "text": "Find out if you're eligible for a VA-backed home loan. If you have a service-connected disability, see if you qualify for a housing grant to help you live more independently."
    },
    {
     "role": "cta",
     "order": 13,
     "text": "Life insurance",
     "href": "/life-insurance"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Explore VA life insurance options for Veterans, service members, and families. Manage your policy online, file claims for benefits, and access helpful resources."
    },
    {
     "role": "cta",
     "order": 15,
     "text": "Burials and memorials",
     "href": "/burials-memorials"
    },
    {
     "role": "body",
     "order": 16,
     "text": "Get help planning a burial in a VA national cemetery, order a headstone or other memorial item to honor a Veteran's service, and apply for survivor and dependent benefits."
    },
    {
     "role": "cta",
     "order": 17,
     "text": "Records",
     "href": "/records"
    },
    {
     "role": "body",
     "order": 18,
     "text": "Apply for a printed Veteran ID card, get your VA benefit letters and medical records, and learn how to apply for a discharge upgrade."
    },
    {
     "role": "cta",
     "order": 19,
     "text": "Service members",
     "href": "/service-member-benefits"
    },
    {
     "role": "body",
     "order": 20,
     "text": "Find out what benefits you may be eligible for during service and which time-sensitive benefits to consider when separating or retiring."
    },
    {
     "role": "cta",
     "order": 21,
     "text": "Family and caregivers",
     "href": "/family-and-caregiver-benefits"
    },
    {
     "role": "body",
     "order": 22,
     "text": "Learn about the benefits you may be eligible for as the spouse, dependent, survivor, or caregiver of a Veteran."
    },
    {
     "role": "cta",
     "order": 23,
     "text": "VA department information",
     "href": "https://department.va.gov/"
    },
    {
     "role": "body",
     "order": 24,
     "text": "Learn more about the VA departments that manage our benefit and health care programs."
    }
   ],
