  {
   "section": "link-list-1",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Get VA health care"
    },
    {
     "role": "cta",
     "order": 1,
     "text": "About VA health benefits",
     "href": "/health-care/about-va-health-benefits/"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Learn how VA health care works and which Veterans health care services we cover."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Eligibility",
     "href": "/health-care/eligibility/"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Find out if you’re eligible for Veterans health care benefits and how priority groups work."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "How to apply",
     "href": "/health-care/how-to-apply/"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Learn how to prepare and apply for VA health care online, by phone, by mail, or in person."
    },
    {
     "role": "cta",
     "order": 7,
     "text": "Apply online (VA Form 10-10EZ)",
     "href": "https://www.va.gov/health-care/apply-for-health-care-form-10-10ez/"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Start your Veterans health care application now."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "After you apply",
     "href": "/health-care/after-you-apply/"
    },
    {
     "role": "body",
     "order": 10,
     "text": "Find out when to expect a decision on your application, and what to do next."
    },
    {
     "role": "cta",
     "order": 11,
     "text": "Foreign Medical Program (FMP)",
     "href": "/health-care/foreign-medical-program/"
    },
    {
     "role": "body",
     "order": 12,
     "text": "Are you getting medical care outside the U.S. for a service-connected condition? Find out how the Foreign Medical Program works and how to register."
    },
    {
     "role": "cta",
     "order": 13,
     "text": "Family and caregiver health benefits",
     "href": "/health-care/family-caregiver-benefits/"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Find out if you qualify for VA medical benefits as a spouse, surviving spouse, dependent child, or caregiver."
    },
    {
     "role": "cta",
     "order": 15,
     "text": "VA Dental Insurance Program (VADIP)",
     "href": "/health-care/about-va-health-benefits/dental-care/dental-insurance/"
    },
    {
     "role": "body",
     "order": 16,
     "text": "Find out if you’re eligible for discounted private dental insurance for Veterans and family members. And learn how to enroll in a plan that best meets your needs."
    }
   ],
