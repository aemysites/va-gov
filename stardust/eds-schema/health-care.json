    },
    {
     "role": "cta",
     "order": 1,
     "text": "Disability compensation (pay)",
     "href": "/disability/"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Learn how to file a claim for disability compensation and manage your disability benefits."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Life insurance",
     "href": "/life-insurance/"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Explore your life insurance options and find out how to apply as a service member, Veteran, or family member."
    },
    {
     "role": "cta",
     "order": 5,
     "text": "Aid and attendance benefits and housebound allowance",
     "href": "/pension/aid-attendance-housebound/"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Find out if you can get increased pension pay as a Veteran or surviving spouse who has disabilities."
    },
    {
     "role": "cta",
     "order": 7,
     "text": "Burial benefits and memorial items",
     "href": "/burials-memorials/"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Learn about Veterans burial benefits, how to plan a burial service, and how to get compensation as a survivor."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Education and training",
     "href": "/education/"
    },
    {
     "role": "body",
     "order": 10,
     "text": "Apply for and manage GI Bill and other education benefits to help pay for college and training programs."
    }
   ],
